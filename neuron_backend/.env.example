# Neuron Wealth backend settings. Copy to .env and fill in real values. Never commit .env.

# Set to "production" on the live server. Turns on HSTS and strict CORS (no localhost exceptions)
# and refuses to start without JWT_SECRET.
NODE_ENV=production
PORT=5000

# Number of proxies in front of the API (hosting load balancer / Nginx). 1 is right for most hosts.
# Needed so rate limits see each visitor's real IP. Use 0 if the API is reached directly.
TRUST_PROXY=1

# Allowed browser origins (website and admin), comma separated.
CORS_ORIGIN=https://neuronwealth.com,https://www.neuronwealth.com

# Public website and admin addresses, used in links inside emails.
SITE_URL=https://neuronwealth.com
ADMIN_APP_URL=https://neuronwealth.com/admin

MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/neuron_wealth

# Long random string (e.g. 64 hex characters). Required in production.
JWT_SECRET=

# First admin account (used only when no admin exists yet).
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Neuron Admin
# Inbox for password/username recovery and admin notifications (defaults to ADMIN_EMAIL).
ADMIN_RECOVERY_EMAIL=

# Outgoing email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
